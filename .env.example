# Hub configuration
AGENTLOOM_HOST=0.0.0.0
AGENTLOOM_PORT=3000
AGENTLOOM_DATA_DIR=./data
# Leave empty to auto-generate into ./data/admin.token on first run
AGENTLOOM_ADMIN_TOKEN=
AGENTLOOM_MAX_ROUNDS=30
AGENTLOOM_MAX_REPLIES_PER_HOUR=60
AGENTLOOM_AGENT_TIMEOUT=90
AGENTLOOM_CONTEXT_LIMIT=15

# MCP / CLI client configuration
AGENTLOOM_URL=http://127.0.0.1:3000
AGENTLOOM_TOKEN=
AGENTLOOM_SENDER=local-agent
